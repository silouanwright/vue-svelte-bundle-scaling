{
  "name": "vue-svelte-bundle-scaling-2026",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": "22.19.0"
  },
  "scripts": {
    "benchmark": "node --expose-gc scripts/run-benchmark.mjs",
    "benchmark:all": "npm run benchmark:original && npm run benchmark && npm run benchmark:route-split && npm run benchmark:matched-app && npm run benchmark:hand-authored && npm run benchmark:optimization-sensitivity && npm run benchmark:weather-upstream && npm run benchmark:weather-staged && npm run benchmark:openslides",
    "benchmark:hand-authored": "node --expose-gc scripts/run-hand-authored.mjs",
    "benchmark:hand-authored:trimmed": "node --expose-gc scripts/run-hand-authored.mjs --trimmed",
    "report": "node scripts/run-benchmark.mjs --report-only",
    "benchmark:original": "node scripts/run-original-specimen.mjs",
    "benchmark:matched-app": "node scripts/run-matched-app.mjs",
    "benchmark:openslides": "node scripts/run-openslides.mjs",
    "benchmark:weather-upstream": "node scripts/run-upstream-weather.mjs",
    "benchmark:weather-staged": "node scripts/run-weather-staged.mjs",
    "benchmark:route-split": "node --expose-gc scripts/run-route-split.mjs",
    "benchmark:route-split:trimmed": "node --expose-gc scripts/run-route-split.mjs --trimmed",
    "benchmark:optimization-sensitivity": "npm run benchmark:route-split:trimmed && npm run benchmark:hand-authored:trimmed",
    "charts": "node scripts/generate-charts.mjs",
    "check": "npm run check:docs && npm run verify",
    "check:docs": "node scripts/check-docs.mjs",
    "test": "npm run test:parity && npm run test:weather-parity && npm run test:openslides-parity",
    "test:parity": "playwright test",
    "test:weather-parity": "playwright test --config playwright.weather.config.mjs",
    "test:openslides-parity": "playwright test --config playwright.openslides.config.mjs",
    "verify": "node scripts/verify-results.mjs",
    "verify:write": "node scripts/verify-results.mjs --write-lock"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0"
  },
  "dependencies": {
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/server-renderer": "3.5.40",
    "svelte": "5.56.8",
    "vite": "8.1.5",
    "vue": "3.5.40"
  }
}
